# Copy to .env.local for local builds. CI reads the same names from GitHub
# secrets (see DEPLOY.md). VITE_* values are compiled into the frontend
# bundle, so treat every one of them as PUBLIC: never put a real secret here.
#
# Every one is optional: left empty, the feature is off and the app talks to
# no server of its own. The hosts of VITE_API_URL and VITE_UMAMI_URL are added
# to the CSP's connect-src by scripts/tauri.mjs (`npm run dev`, `npm run
# build`, CI), so a server set here is reachable without editing
# src-tauri/tauri.conf.json (a local API on http://localhost:3001 too).

# Librarium website API: in-app messages, opt-in error reports, feedback.
# The base URL of your server (e.g. https://api.example.org).
VITE_API_URL=
# Identifies the app to that API. Public (it ships in the app): the server
# must rate-limit and must not grant anything privileged with it.
VITE_API_KEY=

# Umami analytics (opt-in only: nothing is sent until the user consents).
# Your Umami server (e.g. https://stats.example.org) and the website id it
# gave you.
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=
